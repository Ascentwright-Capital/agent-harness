{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git submodule update --init --quiet .agents/shared || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pstack@ascentwright": true,
    "mattpocock-skills@ascentwright": true,
    "emilkowalski-skills@ascentwright": true
  },
  "extraKnownMarketplaces": {
    "ascentwright": {
      "source": {
        "source": "directory",
        "path": "./.agents/shared"
      }
    }
  }
}
